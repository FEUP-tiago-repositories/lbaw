FROM --platform=linux/amd64 node:22-slim AS assets
WORKDIR /app
ARG VITE_PUSHER_APP_KEY=COLA_AQUI_A_CHAVE_PUBLICA
ARG VITE_PUSHER_APP_CLUSTER=eu
ARG VITE_PUSHER_HOST=
ARG VITE_PUSHER_PORT=443
ENV VITE_PUSHER_APP_KEY=$VITE_PUSHER_APP_KEY \
    VITE_PUSHER_APP_CLUSTER=$VITE_PUSHER_APP_CLUSTER \
    VITE_PUSHER_HOST=$VITE_PUSHER_HOST \
    VITE_PUSHER_PORT=$VITE_PUSHER_PORT
COPY . .
RUN npm install && npm run build

FROM --platform=linux/amd64 php:8.5-fpm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       nginx libpq-dev ca-certificates zip unzip git \
    && docker-php-ext-install pdo_pgsql \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www

COPY composer.json composer.lock ./
RUN composer install --optimize-autoloader --prefer-dist --no-progress --no-interaction --no-scripts

COPY --chown=www-data:www-data . .
COPY --from=assets --chown=www-data:www-data /app/public/build /var/www/public/build
RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY ./etc/php/php.ini /usr/local/etc/php/conf.d/php.ini
COPY ./etc/nginx/default.conf /etc/nginx/conf.d/default.conf
RUN sed -i '/fastcgi_index/a\        fastcgi_param  HTTPS on;' /etc/nginx/conf.d/default.conf

COPY docker_run.sh /docker_run.sh
RUN chmod +x /docker_run.sh

EXPOSE 80
CMD ["/docker_run.sh"]
