{
  "name": "lbaw",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "containers": [
    {
      "class_name": "LbawContainer",
      "image": "./Dockerfile.cloudflare",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LBAW", "class_name": "LbawContainer" }]
  },
  "exports": {
    "LbawContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
